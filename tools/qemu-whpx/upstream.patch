diff --git a/accel/whpx/whpx-reset.c b/accel/whpx/whpx-reset.c
new file mode 100644
index 0000000..bf69afb
--- /dev/null
+++ b/accel/whpx/whpx-reset.c
@@ -0,0 +1,74 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "qemu/osdep.h"
+#include "qemu/error-report.h"
+#include "system/whpx-reset.h"
+
+bool whpx_reset_host_supported(bool queried, unsigned major, unsigned minor,
+                               unsigned build, unsigned product, bool x64)
+{
+    return queried && x64 && major == 10 && minor == 0 && build >= 22000 &&
+           product == VER_NT_WORKSTATION;
+}
+
+bool whpx_reset_query_supported_host(void)
+{
+    typedef LONG (WINAPI *RtlGetVersionFn)(OSVERSIONINFOEXW *);
+    HMODULE module = GetModuleHandleW(L"ntdll.dll");
+    RtlGetVersionFn get_version = module ?
+        (RtlGetVersionFn)GetProcAddress(module, "RtlGetVersion") : NULL;
+    OSVERSIONINFOEXW version = { .dwOSVersionInfoSize = sizeof(version) };
+    SYSTEM_INFO system_info = {0};
+    bool x64 = false;
+    bool queried;
+
+    GetNativeSystemInfo(&system_info);
+#if defined(_WIN64) && defined(__x86_64__)
+    x64 = system_info.wProcessorArchitecture == PROCESSOR_ARCHITECTURE_AMD64;
+#endif
+    queried = get_version && get_version(&version) == 0;
+    return whpx_reset_host_supported(queried,
+                                     version.dwMajorVersion,
+                                     version.dwMinorVersion,
+                                     version.dwBuildNumber,
+                                     version.wProductType, x64);
+}
+
+WhpxResetPolicy whpx_select_reset_policy(OnOffAuto requested,
+                                         bool supported_host,
+                                         bool export_present)
+{
+    if (requested != ON_OFF_AUTO_OFF && requested != ON_OFF_AUTO_AUTO &&
+        requested != ON_OFF_AUTO_ON) {
+        return WHPX_RESET_UNSUPPORTED;
+    }
+    if (requested == ON_OFF_AUTO_OFF) {
+        return WHPX_RESET_LEGACY;
+    }
+    if (supported_host && export_present) {
+        return WHPX_RESET_PARTITION;
+    }
+    return requested == ON_OFF_AUTO_ON ? WHPX_RESET_UNSUPPORTED :
+                                        WHPX_RESET_LEGACY;
+}
+
+void whpx_reset_partition_or_exit(WHV_PARTITION_HANDLE partition,
+                                  WhpxResetPartitionFn reset,
+                                  bool all_vps_stopped)
+{
+    HRESULT hr;
+
+    if (!all_vps_stopped) {
+        error_report("WHPX: partition reset refused: virtual processors running");
+        exit(EXIT_FAILURE);
+    }
+    if (!reset) {
+        error_report("WHPX: partition reset requires WHvResetPartition");
+        exit(EXIT_FAILURE);
+    }
+    hr = reset(partition);
+    if (hr != S_OK) {
+        error_report("WHPX: partition reset failed, hr=%08lx", hr);
+        exit(EXIT_FAILURE);
+    }
+    info_report("WHPX: partition reset completed, hr=00000000");
+}
