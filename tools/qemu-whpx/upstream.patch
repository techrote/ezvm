@@ -0,0 +1,61 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#ifndef SYSTEM_WHPX_RESET_H
+#define SYSTEM_WHPX_RESET_H
+
+#include <winhvplatform.h>
+#include "system/whpx-common.h"
+#include "qapi/qapi-types-common.h"
+
+typedef enum WhpxResetPolicy {
+    WHPX_RESET_UNSUPPORTED = -1,
+    WHPX_RESET_LEGACY = 0,
+    WHPX_RESET_PARTITION = 1,
+} WhpxResetPolicy;
+
+typedef struct WhpxResetState {
+    OnOffAuto requested;
+    WhpxResetPolicy effective;
+    bool frozen;
+} WhpxResetState;
+
+static inline void whpx_reset_policy_init(WhpxResetState *state)
+{
+    state->requested = ON_OFF_AUTO_AUTO;
+    state->effective = WHPX_RESET_LEGACY;
+    state->frozen = false;
+}
+
+static inline bool whpx_reset_policy_set(WhpxResetState *state, OnOffAuto value)
+{
+    if (state->frozen || (value != ON_OFF_AUTO_AUTO &&
+                          value != ON_OFF_AUTO_ON && value != ON_OFF_AUTO_OFF)) {
+        return false;
+    }
+    state->requested = value;
+    return true;
+}
+
+bool whpx_reset_host_supported(bool queried, unsigned major, unsigned minor,
+                               unsigned build, unsigned product, bool x64);
+bool whpx_reset_query_supported_host(void);
+WhpxResetPolicy whpx_select_reset_policy(OnOffAuto requested,
+                                         bool supported_host,
+                                         bool export_present);
+
+typedef HRESULT (WINAPI *WhpxResetPartitionFn)(WHV_PARTITION_HANDLE);
+
+/* Never return to board reset or CPU resume on an uncertain partition reset. */
+void whpx_reset_partition_or_exit(WHV_PARTITION_HANDLE partition,
+                                  WhpxResetPartitionFn reset,
+                                  bool all_vps_stopped);
+
+static inline void whpx_reset_cpu_cache(struct AccelCPUState *vcpu)
+{
+    vcpu->window_registered = false;
+    vcpu->window_priority = 0;
+    vcpu->interruption_pending = false;
+    vcpu->ready_for_pic_interrupt = false;
+    vcpu->interruptable = true;
+}
+
+#endif
