diff --git a/tests/unit/test-whpx-reset.c b/tests/unit/test-whpx-reset.c
new file mode 100644
index 0000000..247f59c
--- /dev/null
+++ b/tests/unit/test-whpx-reset.c
@@ -0,0 +1,169 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "qemu/osdep.h"
+#include "system/whpx-reset.h"
+
+static HRESULT mock_result;
+static unsigned mock_calls;
+
+static HRESULT WINAPI mock_reset(WHV_PARTITION_HANDLE partition)
+{
+    g_assert(partition == (WHV_PARTITION_HANDLE)(uintptr_t)0x1234);
+    mock_calls++;
+    g_assert_cmpuint(mock_calls, ==, 1);
+    if (g_test_subprocess()) {
+        g_print("RESET_API_CALLED\n");
+    }
+    return mock_result;
+}
+
+static void test_success(void)
+{
+    mock_result = S_OK;
+    mock_calls = 0;
+    whpx_reset_partition_or_exit((WHV_PARTITION_HANDLE)(uintptr_t)0x1234,
+                                mock_reset, true);
+    g_assert_cmpuint(mock_calls, ==, 1);
+}
+
+static void test_fatal(gconstpointer data)
+{
+    intptr_t scenario = (intptr_t)data;
+
+    if (g_test_subprocess()) {
+        mock_result = scenario == 2 ? S_FALSE :
+                      scenario == 3 ? HRESULT_FROM_WIN32(ERROR_INVALID_STATE) :
+                      E_FAIL;
+        whpx_reset_partition_or_exit((WHV_PARTITION_HANDLE)(uintptr_t)0x1234,
+                                    scenario == 0 ? NULL : mock_reset,
+                                    scenario != 1);
+        g_print("RESET_RETURNED_TO_RESUME\n");
+        return;
+    }
+    g_test_trap_subprocess(NULL, 5000000, 0);
+    g_test_trap_assert_failed();
+    g_test_trap_assert_stdout_unmatched("*RESET_RETURNED_TO_RESUME*");
+    g_test_trap_assert_stderr("*WHPX: partition reset*");
+    if (scenario < 2) {
+        g_test_trap_assert_stdout_unmatched("*RESET_API_CALLED*");
+        g_test_trap_assert_stderr(scenario == 0 ? "*requires WHvResetPartition*" :
+                                                "*virtual processors running*");
+    } else {
+        g_test_trap_assert_stdout("*RESET_API_CALLED*");
+        g_test_trap_assert_stderr(scenario == 2 ? "*hr=00000001*" :
+                                 scenario == 3 ? "*hr=8007139f*" :
+                                                 "*hr=80004005*");
+    }
+}
+
+static void test_cache(void)
+{
+    struct AccelCPUState vcpu;
+    WHV_RUN_VP_EXIT_CONTEXT original_exit;
+
+    memset(&vcpu, 0xa5, sizeof(vcpu));
+    vcpu.window_registered = true;
+    vcpu.window_priority = 99;
+    vcpu.interruption_pending = true;
+    vcpu.ready_for_pic_interrupt = true;
+    vcpu.interruptable = false;
+    vcpu.tpr = 0x77;
+    memcpy(&original_exit, &vcpu.exit_ctx, sizeof(original_exit));
+    whpx_reset_cpu_cache(&vcpu);
+    g_assert_false(vcpu.window_registered);
+    g_assert_cmpint(vcpu.window_priority, ==, 0);
+    g_assert_false(vcpu.interruption_pending);
+    g_assert_false(vcpu.ready_for_pic_interrupt);
+    g_assert_true(vcpu.interruptable);
+    g_assert_cmpuint(vcpu.tpr, ==, 0x77);
+    g_assert(memcmp(&vcpu.exit_ctx, &original_exit, sizeof(original_exit)) == 0);
+}
+
+static void test_policy_default(void)
+{
+    WhpxResetState state;
+
+    memset(&state, 0xa5, sizeof(state));
+    whpx_reset_policy_init(&state);
+    g_assert_cmpint(state.requested, ==, ON_OFF_AUTO_AUTO);
+    g_assert_cmpint(state.effective, ==, WHPX_RESET_LEGACY);
+    g_assert_false(state.frozen);
+    /* An absent export with the actual default must preserve legacy behavior. */
+    g_assert_cmpint(whpx_select_reset_policy(state.requested, true, false), ==,
+                    WHPX_RESET_LEGACY);
+}
+
+static void test_host_scope(void)
+{
+    g_assert_true(whpx_reset_host_supported(true, 10, 0, 22000,
+                                             VER_NT_WORKSTATION, true));
+    g_assert_true(whpx_reset_host_supported(true, 10, 0, 26300,
+                                             VER_NT_WORKSTATION, true));
+    g_assert_false(whpx_reset_host_supported(false, 10, 0, 26300,
+                                              VER_NT_WORKSTATION, true));
+    g_assert_false(whpx_reset_host_supported(true, 10, 0, 19041,
+                                              VER_NT_WORKSTATION, true));
+    g_assert_false(whpx_reset_host_supported(true, 10, 0, 21999,
+                                              VER_NT_WORKSTATION, true));
+    g_assert_false(whpx_reset_host_supported(true, 10, 0, 26300,
+                                              VER_NT_SERVER, true));
+    g_assert_false(whpx_reset_host_supported(true, 10, 0, 26300,
+                                              VER_NT_WORKSTATION, false));
+    g_assert_false(whpx_reset_host_supported(true, 6, 3, 26300,
+                                              VER_NT_WORKSTATION, true));
+    g_assert_false(whpx_reset_host_supported(true, 10, 1, 26300,
+                                              VER_NT_WORKSTATION, true));
+}
+
+static void test_policy_modes(void)
+{
+    g_assert_cmpint(whpx_select_reset_policy((OnOffAuto)99, true, true), ==,
+                    WHPX_RESET_UNSUPPORTED);
+    for (int host = 0; host <= 1; host++) {
+        for (int exported = 0; exported <= 1; exported++) {
+            g_assert_cmpint(whpx_select_reset_policy(ON_OFF_AUTO_OFF, host,
+                                                    exported), ==,
+                            WHPX_RESET_LEGACY);
+            g_assert_cmpint(whpx_select_reset_policy(ON_OFF_AUTO_AUTO, host,
+                                                    exported), ==,
+                            host && exported ? WHPX_RESET_PARTITION :
+                                               WHPX_RESET_LEGACY);
+            g_assert_cmpint(whpx_select_reset_policy(ON_OFF_AUTO_ON, host,
+                                                    exported), ==,
+                            host && exported ? WHPX_RESET_PARTITION :
+                                               WHPX_RESET_UNSUPPORTED);
+        }
+    }
+}
+
+static void test_policy_frozen(void)
+{
+    WhpxResetState state;
+
+    whpx_reset_policy_init(&state);
+    g_assert_true(whpx_reset_policy_set(&state, ON_OFF_AUTO_ON));
+    state.effective = WHPX_RESET_PARTITION;
+    state.frozen = true;
+    g_assert_false(whpx_reset_policy_set(&state, ON_OFF_AUTO_OFF));
+    g_assert_cmpint(state.requested, ==, ON_OFF_AUTO_ON);
+    g_assert_cmpint(state.effective, ==, WHPX_RESET_PARTITION);
+    whpx_reset_policy_init(&state);
+    g_assert_false(whpx_reset_policy_set(&state, (OnOffAuto)99));
+    g_assert_cmpint(state.requested, ==, ON_OFF_AUTO_AUTO);
+}
+
+int main(int argc, char **argv)
+{
+    g_test_init(&argc, &argv, NULL);
+    g_test_add_func("/whpx-reset/s-ok-once", test_success);
+    g_test_add_data_func("/whpx-reset/missing-export", (void *)0, test_fatal);
+    g_test_add_data_func("/whpx-reset/vp-running", (void *)1, test_fatal);
+    g_test_add_data_func("/whpx-reset/s-false", (void *)2, test_fatal);
+    g_test_add_data_func("/whpx-reset/invalid-state", (void *)3, test_fatal);
+    g_test_add_data_func("/whpx-reset/e-fail", (void *)4, test_fatal);
+    g_test_add_func("/whpx-reset/cache-only", test_cache);
+    g_test_add_func("/whpx-reset/policy-default", test_policy_default);
+    g_test_add_func("/whpx-reset/host-scope", test_host_scope);
+    g_test_add_func("/whpx-reset/policy-modes", test_policy_modes);
+    g_test_add_func("/whpx-reset/policy-frozen", test_policy_frozen);
+    return g_test_run();
+}
