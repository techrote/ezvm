+static void whpx_set_partition_reset(Object *obj, Visitor *v, const char *name,
+                                     void *opaque, Error **errp)
+{
+    OnOffAuto value;
+
+    if (!visit_type_OnOffAuto(v, name, &value, errp)) {
+        return;
+    }
+    if (!whpx_reset_policy_set(&whpx_global.reset_policy, value)) {
+        error_setg(errp, "WHPX: partition reset policy is fixed after initialization");
+    }
+}
+
+static void whpx_pre_reset_vm(AccelState *as)
+{
+    CPUState *cpu;
+    bool stopped;
+
+    if (whpx_global.reset_policy.effective == WHPX_RESET_LEGACY) {
+        return;
+    }
+    stopped = qatomic_read(&whpx_global.running_cpus) == 0;
+
+    CPU_FOREACH(cpu) {
+        stopped = stopped && cpu_is_stopped(cpu);
+    }
+    whpx_reset_partition_or_exit(whpx_global.partition,
+                                whp_dispatch.WHvResetPartition, stopped);
+    CPU_FOREACH(cpu) {
+        whpx_reset_cpu_cache(cpu->accel);
+    }
+}
+
